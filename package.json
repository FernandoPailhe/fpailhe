{
  "name": "ferpa",
  "private": true,
  "type": "module",
  "version": "0.4.0",
  "description": "Sitio personal de Fernando Pailhe — monorepo pnpm + Vite + React + TypeScript + TanStack Query + Zustand + Tailwind.",
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm build:packages && pnpm --filter @ferpa/web dev",
    "build": "pnpm build:packages && pnpm --filter @ferpa/web build",
    "build:packages": "pnpm --filter @ferpa/data-model build && pnpm --filter @ferpa/ui build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:packages && vitest run",
    "test:watch": "pnpm build:packages && vitest",
    "preview": "pnpm --filter @ferpa/web preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}
