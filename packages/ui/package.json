{
  "name": "@ferpa/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de diseño: theme editable (tokens → CSS variables) + componentes atómicos (atoms/molecules).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme-tokens": {
      "types": "./dist/theme/tokenExports.d.ts",
      "default": "./dist/theme/tokenExports.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
