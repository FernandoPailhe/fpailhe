# Base URL del backend de datos.
# Hoy son los JSON estáticos en public/data.
# El día que haya un servidor real, alcanza con apuntar esto a su URL —
# ver apps/web/src/services/dataService.ts.
VITE_API_BASE_URL=/data

# --- Rugby Chess multiplayer (Firebase Realtime Database) ---
# Opcional: sin estas variables el módulo funciona solo en modo local.
# Ver doc/firebase-multiplayer-setup.md
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=
